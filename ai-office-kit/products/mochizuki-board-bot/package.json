{
  "name": "mochizuki-board-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "実物のホワイトボードと同じ見た目のGoogleスプレッドシートを、LINEの一言で動かす独立Bot（望月オート案件）",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "notify": "node bin/notify.mjs",
    "notify:dry": "node bin/notify.mjs --dry",
    "check": "node scripts/selftest.mjs",
    "build": "node scripts/build-whiteboard.mjs",
    "build:empty": "node scripts/build-whiteboard.mjs --empty",
    "demo": "node scripts/demo-seed.mjs"
  }
}
