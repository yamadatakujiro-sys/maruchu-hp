# =============================================================
#  工程ボードBot 環境変数（このファイルを .env にコピーして埋める）
#  ※ .env は絶対にGitに入れない（.gitignore 済み）
# =============================================================

# --- 待受ポート（cloudflaredトンネルをこのポートに向ける） ---
PORT=18790

# --- LINE Messaging API ---
# LINE Developers → 対象チャネル → Messaging API設定 から取得
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 先回り通知の送り先 ---
# 会社のグループID（推奨）か、テストなら自分のユーザーID。
# 最初は空でOK。Botをグループに入れて1回発言→サーバーのログに出る
#   [recv] group target=Cxxxx ...  の Cxxxx / Uxxxx をここに貼る。
NOTIFY_TARGET=

# --- Anthropic API（本番の解釈エンジン＝Claude） ---
# console.anthropic.com で発行。Claude Codeのプラン(Pro/Max)とは別物。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 省略時は Haiku 4.5（安価で十分）
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google Sheets（サービスアカウント） ---
# スプレッドシートID（URLの /d/ と /edit の間）
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 【推奨】ダウンロードしたJSONキーのパスを指すだけ（秘密鍵のコピペ不要・事故ゼロ）。
# 例: secret/service-account.json に置いて↓を指定（secret/ はGit管理外）。
GOOGLE_KEY_FILE=secret/service-account.json
#
# 【別法】JSONを置きたくない場合は、下2つに直接値を入れる（GOOGLE_KEY_FILE は空にする）。
# スプレッドシートは client_email 宛に「編集者」で共有すること。
# GOOGLE_CLIENT_EMAIL=board-bot@your-project.iam.gserviceaccount.com
# 秘密鍵は1行で、改行を \n に置き換えて（前後の -----BEGIN/END----- も含める）
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- タブ名を変えたい場合のみ（既定：工程ボード） ---
# SHEET_TAB=工程ボード
